---
import "@fontsource/archivo/latin-800.css";
import "@fontsource/archivo/latin-900.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import archivo800 from "@fontsource/archivo/files/archivo-latin-800-normal.woff2?url";
import plex400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Rulers from "../components/Rulers.astro";
import Transition from "../components/Transition.astro";
interface Props { title: string; description: string; jsonLd?: object; noindex?: boolean }
const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={archivo800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Transition />
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <Rulers />
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
