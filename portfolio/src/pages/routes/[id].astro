---
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import StatRow from "../../components/StatRow.astro";
import Itinerary from "../../components/Itinerary.astro";
import Explore from "../../components/Explore.astro";
import Footer from "../../components/Footer.astro";
import { routes, type Route } from "../../data/site";

export function getStaticPaths() {
  return routes.map((r) => ({ params: { id: r.id }, props: { route: r } }));
}
const { route } = Astro.props as { route: Route };
const heading = route.months
  ? `${route.months}-month<br />route overview`
  : `Route<br />overview`;
---
<Base title={`${route.name}: ${route.title} · Nguyen Le`} description={route.overview}>
  <main id="main">
    <section class="dhero" data-dark aria-labelledby="dhero-h">
      <div class="dhero__media" data-hero-media><Plate kind={route.plate} id={route.id} eager /></div>
      <div class="dhero__inner grid">
        <h1 id="dhero-h" class="dhero__title" data-hero-title>{route.name}</h1>
        <p class="dhero__sub" data-hero-fade>{route.title}</p>
      </div>
    </section>
    <div class="grid"><div class="c-full dhero__marks" aria-hidden="true"></div></div>
    <div class="dstats"><StatRow items={route.stats} /></div>

    <Itinerary heading={heading} intro={route.overview} rows={route.steps} cta={route.cta} id="overview" />
    <Explore exclude={route.id} />
  </main>
  <Footer />
</Base>

<style>
  .dhero { position: relative; height: 88svh; min-height: 30rem; overflow: hidden; color: #fff; }
  .dhero__media { position: absolute; inset: 0; will-change: transform; }
  .dhero__media :global(.plate) { height: 100%; }
  .dhero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,16,12,0.5), rgba(20,16,12,0) 45%); }
  .dhero__inner { position: relative; z-index: 1; padding-top: 7.5rem; align-content: start; }
  .dhero__title { grid-column: 1 / span 9; font-size: var(--fs-h1); }
  .dhero__sub { grid-column: 1 / span 6; margin-top: 1.25rem; font: 800 clamp(1.3rem, 0.8rem + 1.8vw, 2.4rem)/1 var(--display); max-width: 18ch; }
  .dhero__marks { position: relative; height: 14px; margin-top: -8px; }
  .dhero__marks::before, .dhero__marks::after { content: ""; position: absolute; top: 0; width: 14px; height: 14px; border-bottom: 1.5px solid var(--red); }
  .dhero__marks::before { left: -6px; border-left: 1.5px solid var(--red); }
  .dhero__marks::after { right: -6px; border-right: 1.5px solid var(--red); }
  .dstats { margin-top: 1.5rem; }
  @media (max-width: 860px) { .dhero__title, .dhero__sub { grid-column: 1 / -1; } }
</style>
