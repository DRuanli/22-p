---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Founder from "../components/Founder.astro";
import Routes from "../components/Routes.astro";
import Feature from "../components/Feature.astro";
import Itinerary from "../components/Itinerary.astro";
import Profile from "../components/Profile.astro";
import Publications from "../components/Publications.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import { milestones } from "../data/site";
// "Words from others" stays out until docs/content.md has real quotes.
---
<Base
  title="Nguyen Le, academic journey"
  description="Dang Nguyen Le (published as Nguyen Le): data mining and educational machine learning researcher at Ton Duc Thang University, valedictorian, English teacher."
>
  <main id="main">
    <Hero />
    <Founder />
    <Routes />
    <Feature />
    <Publications />
    <Itinerary
      id="journey"
      heading="The route<br />so far"
      intro="From a school in Can Tho to a research post in Ho Chi Minh City, by way of Regensburg. Nine stops, all from the CV."
      rows={milestones}
      cta={{ label: "Plan the next stop", href: "#contact" }}
    />
    <Profile />
    <Faq />
  </main>
  <Footer />
</Base>
