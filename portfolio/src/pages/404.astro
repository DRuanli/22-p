---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Off the map · Nguyen Le" description="This page does not exist.">
  <main id="main" tabindex="-1" class="lost" data-dark data-section="Off the map">
    <div class="grid lost__inner">
      <p class="lost__code" data-hero-fade>404</p>
      <h1 class="lost__title" data-hero-title>Off the<br />map</h1>
      <p class="lost__text justify" data-scramble-in>This route does not exist, or it has moved. The way back starts here.</p>
      <div class="lost__cta" data-hero-fade><a class="btn" href={base}>Back to all routes</a></div>
    </div>
  </main>
</Base>

<style>
  .lost { min-height: 100svh; background: var(--film-dark); color: #fff; display: flex; align-items: center; }
  .lost__inner { width: 100%; row-gap: 2rem; padding-block: 8rem 4rem; }
  .lost__code { grid-column: 1 / -1; color: var(--red); }
  .lost__title { grid-column: 1 / span 8; font-size: var(--fs-h1); }
  .lost__text { grid-column: 9 / span 4; align-self: end; }
  .lost__cta { grid-column: 1 / -1; }
  @media (max-width: 860px) { .lost__title, .lost__text { grid-column: 1 / -1; } }
</style>
