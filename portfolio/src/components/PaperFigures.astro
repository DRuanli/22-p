---
// Figures reused from an open-access paper, with credit. Click opens the full image.
interface Props { figures: { src: string; caption: string; credit: string }[] }
const { figures } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="section pfig" data-section="Figures" aria-labelledby="pfig-h">
  <div class="grid">
    <h2 id="pfig-h" class="c-head" data-reveal>Figures from<br />the paper</h2>
    <p class="c-right justify pfig__intro" data-scramble>Reproduced from the open-access article. Open a figure for full size.</p>
  </div>
  <div class="grid pfig__list">
    {figures.map((f, i) => (
      <figure class:list={["pfig__item", i === 0 ? "pfig__item--wide" : ""]} data-pfig>
        <a class="crop pfig__frame" href={`${base}${f.src}`} target="_blank" rel="noopener" aria-label={`Open full size: ${f.caption}`}>
          <img src={`${base}${f.src}`} alt={f.caption} loading="lazy" decoding="async" />
        </a>
        <figcaption>
          <p class="pfig__cap">{f.caption}</p>
          <p class="label">{f.credit}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .pfig__intro { margin-top: 2rem; }
  .pfig__list { margin-top: 3.5rem; row-gap: 3.5rem; }
  .pfig__item { grid-column: span 6; margin: 0; display: grid; gap: 1.1rem; align-content: start; }
  .pfig__item--wide { grid-column: 1 / -1; }
  .pfig__item--wide .pfig__frame img { max-height: 32rem; object-fit: contain; }
  .pfig__frame { display: block; background: #fff; overflow: hidden; }
  .pfig__frame img { display: block; width: 100%; height: auto; transition: transform 0.8s var(--ease); }
  .pfig__frame:hover img { transform: scale(1.02); }
  .pfig__cap { text-transform: none; letter-spacing: 0; line-height: 1.6; max-width: 70ch; }
  @media (max-width: 860px) { .pfig__item { grid-column: 1 / -1; } }
</style>
