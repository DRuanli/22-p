---
import { languages } from "../data/site";
---
<section class="section what" aria-labelledby="what-h">
  <div class="wrap">
    <h2 id="what-h" data-reveal>What I <em>do</em></h2>
    <div class="what__cols">
      <article>
        <h3>Research</h3>
        <p>
          Exact pattern-mining algorithms for uncertain data, with pruning bounds I can prove correct.
          In educational machine learning I build evaluations that only use what a school actually
          knows at prediction time.
        </p>
      </article>
      <article>
        <h3>Teaching</h3>
        <p>
          English for learners from primary school to upper-secondary, with exam classes for Flyers,
          PET and IELTS.
        </p>
      </article>
      <article>
        <h3>Languages and travel</h3>
        <dl class="langs">
          {languages.map((l) => (<div><dt>{l.name}</dt><dd>{l.level}</dd></div>))}
        </dl>
        <p>
          Five north–south journeys across Vietnam since 2019, and solo trips in Germany, France,
          Austria and Taiwan.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .what__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); margin-top: var(--space-l); }
  article { border-top: 2px solid var(--deep); padding-top: 1.25rem; }
  article h3 { margin-bottom: 0.9rem; }
  article p { color: var(--ink-muted); max-width: 40ch; }
  .langs { margin: 0 0 1rem; display: grid; gap: 0.35rem; }
  .langs div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px dotted var(--reed-light); padding-bottom: 0.35rem; }
  .langs dt { font-weight: 600; }
  .langs dd { margin: 0; color: var(--ink-muted); }
  @media (max-width: 860px) { .what__cols { grid-template-columns: minmax(0, 1fr); } }
</style>
