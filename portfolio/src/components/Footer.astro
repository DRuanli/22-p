---
import { existsSync } from "node:fs";
import { person } from "../data/site";
const base = import.meta.env.BASE_URL;
const hasCv = existsSync("public/cv.pdf");
---
<footer class="foot" id="contact" aria-labelledby="contact-h">
  <div class="grid">
    <h2 id="contact-h" class="c-head" data-reveal>Let's plan<br />the next route</h2>
    <p class="c-right justify foot__text" data-scramble>
      Research collaboration, a question about one of the papers, or English classes:
      write to me and I will answer by email.
    </p>
    <div class="c-full foot__mail crop">
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </div>
    <nav class="c-full foot__links" aria-label="Profiles">
      <a class="bracket" href={person.scholar} target="_blank" rel="noopener">Google Scholar</a>
      <a class="bracket" href={person.orcid} target="_blank" rel="noopener">ORCID {person.orcidId}</a>
      {hasCv && <a class="bracket" href={`${base}cv.pdf`} download>Download CV</a>}
    </nav>
    <p class="c-full foot__small muted">© {new Date().getFullYear()} {person.name}. {person.location}.</p>
  </div>
</footer>

<style>
  .foot { padding-block: var(--section) 2rem; }
  .foot__text { margin-top: 2rem; }
  .foot__mail { margin-top: 4rem; padding: 2.5rem 1rem; text-align: center; }
  .foot__mail a { font: 800 clamp(1.4rem, 0.6rem + 3.6vw, 3.6rem)/1 var(--display); text-decoration: none; text-transform: uppercase; overflow-wrap: anywhere; }
  .foot__mail a:hover { color: var(--red); }
  .foot__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2.5rem; margin-top: 2rem; }
  .foot__small { margin-top: 5rem; font-size: var(--fs-mono-s); }
</style>
