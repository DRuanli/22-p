---
import { papers } from "../data/site";
// Rendered twice so the looping carousel always has neighbours on both sides.
const slides = [...papers, ...papers];
---
<section class="section papers" aria-labelledby="papers-h">
  <div class="grid">
    <h2 id="papers-h" class="c-head" data-reveal>Published<br />routes</h2>
  </div>
  <div class="papers__viewport" data-papers>
    <ul class="papers__track">
      {slides.map((p, i) => (
        <li class="papers__slide" aria-hidden={i >= papers.length ? "true" : undefined}>
          <p class="label">{p.venue} · {p.year}</p>
          <p class="justify papers__title">{p.title}</p>
          <p class="muted">{p.authors} {p.status}</p>
          {p.href && <a class="bracket" href={p.href} target="_blank" rel="noopener" tabindex={i >= papers.length ? -1 : undefined}>Read the article</a>}
        </li>
      ))}
    </ul>
  </div>
  <div class="grid">
    <div class="c-center papers__nav">
      <span class="papers__crop crop" aria-hidden="true"></span>
      <button type="button" data-papers-prev aria-label="Previous article"><svg width="8" height="12" viewBox="0 0 8 12" aria-hidden="true"><path d="M7 1 2 6l5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>Prev</button>
      <span class="papers__line" aria-hidden="true"></span>
      <button type="button" data-papers-next aria-label="Next article">Next<svg width="8" height="12" viewBox="0 0 8 12" aria-hidden="true"><path d="m1 1 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></button>
    </div>
  </div>
</section>

<style>
  .papers__viewport { overflow: hidden; margin-top: 4rem; }
  .papers__track { list-style: none; margin: 0; padding: 0; display: flex; touch-action: pan-y pinch-zoom; }
  .papers__slide {
    flex: 0 0 min(30rem, 84vw); min-width: 0; padding-inline: 2rem;
    display: grid; gap: 0.9rem; align-content: start;
    color: var(--grey-2); transition: color 0.5s;
  }
  .papers__slide .label, .papers__slide .muted { color: inherit; }
  .papers__slide.is-snapped { color: var(--ink); }
  .papers__slide.is-snapped .label, .papers__slide.is-snapped .muted { color: var(--grey); }
  .papers__title { font-size: 0.9rem; }
  .papers__nav { position: relative; display: flex; align-items: center; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; }
  .papers__crop { position: absolute; inset: -2.5rem 0 auto; height: 2.75rem; background-size: 0 0, 0 0, 0 0, 0 0, 14px 1.5px, 1.5px 14px, 14px 1.5px, 1.5px 14px; }
  .papers__nav button { display: inline-flex; align-items: center; gap: 0.75rem; background: none; border: 0; cursor: pointer; font: inherit; text-transform: uppercase; color: inherit; padding: 0.5rem 0; }
  .papers__nav button:hover { color: var(--red); }
  .papers__line { flex: 1; height: 1px; background: var(--ink); }
</style>
