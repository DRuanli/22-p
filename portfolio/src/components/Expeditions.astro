---
import { expeditions } from "../data/site";
import Cover from "./Cover.astro";
---
<section class="section exp" id="expeditions" aria-labelledby="exp-h">
  <div class="wrap sec-head">
    <div>
      <h2 id="exp-h" data-reveal>Research <em>expeditions</em></h2>
      <p class="lede">Three projects, each from first question to published article. Open one for the full route.</p>
    </div>
    <div class="exp__ctrl">
      <button class="icon-btn" type="button" data-rail-prev aria-label="Previous project">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
      <button class="icon-btn" type="button" data-rail-next aria-label="Next project">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
    </div>
  </div>

  <div class="rail" data-rail>
    <ul class="rail__track">
      {expeditions.map((e) => (
        <li class="tour" data-card>
          <div class="tour__media">
            <Cover kind={e.cover} />
            <span class="tour__badge">{e.months} months</span>
          </div>
          <div class="tour__body">
            <p class="tour__period">{e.period}</p>
            <h3><span class="tour__name">{e.name}</span> {e.subtitle}</h3>
            <p class="tour__summary">{e.summary}</p>
            <div class="tour__foot">
              <span class="tour__result">{e.result.label}</span>
              <button class="btn btn--small" type="button" data-open={e.id}>See the route</button>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  {expeditions.map((e) => (
    <dialog class="route" id={`route-${e.id}`} aria-labelledby={`route-${e.id}-h`}>
      <div class="route__inner">
        <button class="route__close icon-btn" type="button" data-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 3l12 12M15 3 3 15" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
        <div class="route__media"><Cover kind={e.cover} /></div>
        <div class="route__text">
          <p class="tour__period">{e.period} · {e.months} months</p>
          <h3 id={`route-${e.id}-h`}><span class="tour__name">{e.name}</span> {e.subtitle}</h3>
          <p class="route__team">{e.team}</p>
          <ol class="route__steps">
            {e.steps.map((s) => (
              <li><h4>{s.title}</h4><p>{s.body}</p></li>
            ))}
          </ol>
          {e.result.href
            ? <a class="btn" href={e.result.href} target="_blank" rel="noopener">Read in {e.result.label}</a>
            : <p class="route__team">{e.result.label}</p>}
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .exp__ctrl { display: flex; gap: 0.75rem; }
  .rail { overflow: hidden; padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
  .rail__track { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; touch-action: pan-y pinch-zoom; }

  .tour {
    flex: 0 0 min(30rem, 86vw); min-width: 0;
    background: var(--foam); border-radius: var(--r-media); overflow: hidden;
    display: flex; flex-direction: column; cursor: grab;
  }
  .tour__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .tour__media :global(svg) { transition: transform 0.8s var(--ease-out); }
  .tour:hover .tour__media :global(svg) { transform: scale(1.04); }
  .tour__badge {
    position: absolute; left: 1rem; top: 1rem; padding: 0.35em 0.9em; border-radius: var(--r-pill);
    background: var(--mist); color: var(--deep); font-size: var(--step--1); font-weight: 600;
  }
  .tour__body { padding: 1.5rem 1.75rem 1.75rem; display: flex; flex-direction: column; gap: 0.8rem; flex: 1; }
  .tour__period { color: var(--danube); font-weight: 600; font-size: var(--step--1); }
  .tour h3, .route h3 { font-size: 1.6rem; line-height: 1.15; }
  .tour__name { display: block; font-style: italic; color: var(--silt); margin-bottom: 0.15rem; }
  .tour__summary { color: var(--ink-muted); flex: 1; }
  .tour__foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; padding-top: 1rem; border-top: 1px solid #d4ddd6; }
  .tour__result { font-family: var(--serif); font-style: italic; }
  :global(.btn--small) { padding: 0.6em 1.15em; font-size: 0.95rem; border: 0; cursor: pointer; font-family: inherit; }

  .route {
    width: min(64rem, calc(100vw - 2rem)); max-height: calc(100svh - 2rem);
    padding: 0; border: 0; border-radius: var(--r-media);
    background: var(--mist); color: var(--deep); overflow: auto;
  }
  .route::backdrop { background: rgba(16, 38, 31, 0.7); backdrop-filter: blur(4px); }
  .route__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); position: relative; }
  .route__media { min-height: 100%; }
  .route__media :global(svg) { height: 100%; min-height: 20rem; }
  .route__text { padding: clamp(1.5rem, 4vw, 3rem); display: grid; gap: 1rem; align-content: start; }
  .route__team { color: var(--ink-muted); font-style: italic; }
  .route__close { position: absolute; top: 1rem; right: 1rem; background: var(--mist); color: var(--deep); z-index: 1; }
  .route__steps { list-style: none; margin: 0.5rem 0 1rem; padding: 0; counter-reset: step; }
  .route__steps li { position: relative; padding: 0 0 1.25rem 2.75rem; counter-increment: step; }
  .route__steps li::before {
    content: counter(step); position: absolute; left: 0; top: 0; width: 1.9rem; height: 1.9rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--deep); color: var(--mist); font-size: 0.85rem;
  }
  .route__steps li:not(:last-child)::after { content: ""; position: absolute; left: 0.9rem; top: 2.1rem; bottom: 0.2rem; width: 2px; background: var(--reed-light); }
  .route__steps li:last-child::before { background: var(--silt); color: var(--deep); }
  .route__steps h4 { margin: 0.2rem 0 0.25rem; font-family: var(--serif); font-weight: 400; font-size: 1.25rem; }
  .route__steps p { color: var(--ink-muted); font-size: 0.97rem; }
  @media (max-width: 760px) {
    .route__inner { grid-template-columns: minmax(0, 1fr); }
    .route__media :global(svg) { min-height: 0; aspect-ratio: 4 / 3; height: auto; }
  }
</style>
