---
import { papers, interests } from "../data/site";
---
<section class="section journeys" id="journeys" aria-labelledby="journeys-h">
  <div class="wrap journeys__head">
    <div>
      <h2 id="journeys-h" data-reveal>Research <em>journeys</em></h2>
      <p class="lede">Three first-author journal articles, all in Q1 journals (SCImago 2025).</p>
    </div>
    <div class="journeys__ctrl">
      <button class="icon-btn" type="button" data-rail-prev aria-label="Previous paper">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
      <button class="icon-btn" type="button" data-rail-next aria-label="Next paper">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
    </div>
  </div>

  <div class="rail" data-rail>
    <ul class="rail__track">
      {papers.map((p) => (
        <li class="card" data-card>
          <p class="card__venue"><span>{p.venue}</span><span>{p.year}</span></p>
          <h3>{p.title}</h3>
          <p class="card__authors">{p.authors}</p>
          <p class="card__finding">{p.finding}</p>
          {p.href
            ? <a class="card__link" href={p.href} rel="noopener" target="_blank">Read the paper<span class="visually-hidden"> (opens DOI page)</span></a>
            : <p class="card__status">{p.status}</p>}
        </li>
      ))}
      <li class="card card--interests" data-card>
        <p class="card__venue"><span>What I keep coming back to</span></p>
        <ul>
          {interests.map((i) => <li>{i}</li>)}
        </ul>
      </li>
    </ul>
  </div>
</section>

<style>
  .journeys { background: var(--foam); }
  .journeys__head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; }
  .journeys__head .lede { margin-top: 1rem; }
  .journeys__ctrl { display: flex; gap: 0.75rem; }

  .rail { overflow: hidden; margin-top: var(--space-l); padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
  .rail__track { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; touch-action: pan-y pinch-zoom; }
  .card {
    flex: 0 0 min(25rem, 84vw); min-width: 0;
    display: flex; flex-direction: column; gap: 0.9rem;
    padding: 1.75rem; border-radius: var(--r-card);
    background: var(--mist); border: 1px solid #d4ddd6;
    cursor: grab;
  }
  .card:active { cursor: grabbing; }
  .card__venue { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--step--1); color: var(--danube); font-weight: 600; }
  .card h3 { font-size: 1.45rem; line-height: 1.2; }
  .card__authors { font-size: var(--step--1); color: var(--ink-muted); }
  .card__finding { color: var(--ink-muted); flex: 1; }
  .card__link { font-weight: 600; color: var(--danube); align-self: start; }
  .card__status { font-size: var(--step--1); color: var(--ink-muted); font-style: italic; }

  .card--interests { background: var(--deep); color: var(--mist); border-color: var(--deep); }
  .card--interests .card__venue { color: var(--silt-soft); }
  .card--interests ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .card--interests li { font-family: var(--serif); font-size: 1.5rem; line-height: 1.2; border-bottom: 1px solid #2c4a3f; padding-bottom: 0.9rem; }
  .card--interests li:last-child { border-bottom: 0; }
</style>
