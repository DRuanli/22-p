---
import { faq } from "../data/site";
---
<section class="section faq" id="faq" aria-labelledby="faq-h" data-section="FAQ">
  <div class="grid">
    <h2 id="faq-h" class="c-head" data-reveal>You still<br />have questions?<br />Here are answers</h2>
    <div class="c-full ruled faq__grid">
      {faq.map((f, i) => (
        <div class="faq__cell">
          <button type="button" aria-expanded="false" aria-controls={`faq-a-${i}`} data-faq>
            <span>{f.q}</span><span class="faq__sign" aria-hidden="true"></span>
          </button>
          <div class="faq__a" id={`faq-a-${i}`} hidden><p class="justify">{f.a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 4rem; }
  .faq__cell { min-height: 15rem; display: flex; flex-direction: column; gap: 1rem; }
  .faq__cell button {
    display: flex; justify-content: space-between; align-items: start; gap: 1rem; text-align: left;
    background: none; border: 0; padding: 0; font: inherit; text-transform: uppercase; color: inherit; cursor: pointer;
  }
  .faq__cell button:hover { color: var(--red); }
  .faq__sign { flex: none; position: relative; width: 12px; height: 12px; margin-top: 0.2rem; }
  .faq__sign::before, .faq__sign::after { content: ""; position: absolute; left: 0; top: 50%; width: 100%; height: 1.5px; background: var(--red); transition: transform 0.4s var(--ease); }
  .faq__sign::after { transform: rotate(90deg); }
  [aria-expanded="true"] .faq__sign::after { transform: rotate(0); }
  .faq__a { color: var(--grey); }
  @media (max-width: 960px) { .faq__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .faq__cell { min-height: 11rem; } }
  @media (max-width: 560px) { .faq__grid { grid-template-columns: minmax(0, 1fr); } .faq__cell { min-height: 0; border-right: 1px solid var(--line); } }
</style>
